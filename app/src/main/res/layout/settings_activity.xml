<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:fitsSystemWindows="true"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="16dp">

  <!-- Toolbar als MaterialCard -->
  <com.google.android.material.card.MaterialCardView
    android:id="@+id/toolbarCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="?attr/toolBarBackground"
    app:strokeColor="?attr/colorToolbarShadow"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@android:color/transparent"
      android:minHeight="?attr/actionBarSize"
      android:theme="?attr/actionBarTheme"
      app:logo="@mipmap/ic_launcher_aal_round"
      app:titleTextColor="?attr/colorToolbarText" />

  </com.google.android.material.card.MaterialCardView>

  <!-- Pegel Einstellungen als MaterialCard -->
  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeColor="?attr/colorToolbarShadow"
    app:strokeWidth="1dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

      <!-- Pegelstände Ort -->
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/water_level_location"
        android:textSize="18sp"
        android:textStyle="bold" />

      <Spinner
        android:id="@+id/spinner_locality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:spinnerMode="dropdown" />

      <!-- Pegelstände Intervall -->
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reads_water_levels"
        android:textSize="16sp" />

      <Spinner
        android:id="@+id/spinner_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:spinnerMode="dropdown" />

      <!-- Wellenerkennung -->
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/wave_detection"
        android:textSize="16sp" />

      <EditText
        android:id="@+id/wave_threshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="z.B. 15"
        android:inputType="number" />

      <!-- Graph Anzahl Messwerte -->
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/level_measur_houer"
        android:textSize="16sp" />

      <Spinner
        android:id="@+id/spinner_Measure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:spinnerMode="dropdown" />

    </LinearLayout>

  </com.google.android.material.card.MaterialCardView>  <!-- Alarm Einstellungen als MaterialCard -->
  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeColor="?attr/colorToolbarShadow"
    app:strokeWidth="1dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

      <!-- Vibrationsalarm -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/vibration_alarm"
          android:textSize="16sp" />

        <Switch
          android:id="@+id/switch_vibration"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:hapticFeedbackEnabled="true"
          android:thumb="@drawable/switch_thumb"
          android:track="@drawable/switch_track" />
      </LinearLayout>

      <!-- Trennabstand -->
      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/colorToolbarShadow"/>

      <!-- Benachrichtigungsalarm -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/beep"
          android:textSize="16sp" />

        <Switch
          android:id="@+id/switch_beep"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:hapticFeedbackEnabled="true"
          android:thumb="@drawable/switch_thumb"
          android:track="@drawable/switch_track" />
      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView></LinearLayout>
